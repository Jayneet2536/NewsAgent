GROQ_API_KEY=
TAVILY_API_KEY=
YOUTUBE_API_KEY=

# Defaults to the model already used successfully by the planner.
GROQ_MODEL=openai/gpt-oss-120b
# Optional role overrides: PLANNER_MODEL, WRITER_MODEL, VERIFIER_MODEL

GROQ_TPM_LIMIT=8000
LLM_INPUT_BUDGET=5000
LLM_OUTPUT_BUDGET=1200
RESEARCH_MAX_QUERIES=6
RESEARCH_MAX_SOURCES=12
DATABASE_PATH=data/newsagent.sqlite3
